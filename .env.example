# --- CALL-E credentials -----------------------------------------------
# Required: get this from dashboard.heycall-e.com/account/api-keys after
# signing up at heycall-e.com. New accounts get 20 free calls automatically.
CALLE_API_KEY=

# Optional — only set this if CALL-E's dashboard explicitly tells you to
# point at a non-default environment. Leave blank to use their standard
# production endpoint.
CALLE_BASE_URL=

# --- GhostLead server ----------------------------------------------------
PORT=3000

# Public URL CALL-E can reach to deliver webhook results back to this app.
# Locally, run a tunnel (e.g. `ngrok http 3000`) and paste its https URL here.
# When deployed (Render, Railway, etc.) use that service's public URL,
# e.g. https://ghostlead-api.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
