# --- CALL-E credentials -----------------------------------------------
# Get these from your CALL-E account after following the install guide:
# https://github.com/CALLE-AI/call-e-integrations
# New accounts get 20 free calls automatically.
CALLE_API_KEY=
CALLE_BASE_URL=

# --- GhostLead server ----------------------------------------------------
PORT=3000

# Public URL CALL-E can reach to deliver webhook results back to this app.
# Locally, run a tunnel (e.g. `ngrok http 3000`) and paste its https URL here.
# When deployed (Render, Fly.io, Railway, etc.) use that service's public URL.
PUBLIC_BASE_URL=http://localhost:3000
